---
import { ClientRouter } from 'astro:transitions';
import Seo, { type Crumb } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article' | 'profile';
	crumbs?: Crumb[];
	entity?: Record<string, unknown> | null;
	noindex?: boolean;
	published?: Date;
	modified?: Date;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#13110d" />
		<meta name="color-scheme" content="dark" />
		<link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/bricolage-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Seo {...props} />
		<ClientRouter />
		<script is:inline>
			document.documentElement.classList.add('js');
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<Palette />
		<canvas id="scope-gl" aria-hidden="true" transition:persist="scope"></canvas>
		<div class="grain" aria-hidden="true"></div>
		<p class="sr-only" aria-live="polite" data-announcer></p>
		<script>
			import '../scripts/app';
		</script>
	</body>
</html>
