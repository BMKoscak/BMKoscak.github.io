---
// The structure of the commercial's 30-second music cue, drawn to scale.
const sections = [
	{ from: 0, to: 5, label: 'Sub drone, cold pads' },
	{ from: 5, to: 11, label: 'Arpeggiated bass enters' },
	{ from: 11, to: 24, label: 'Drums, gated snare, distorted bass, rising leads' },
	{ from: 24, to: 30, label: 'Drop to one sub hit, long reverb tail' },
];
const W = 900;
const x = (s: number) => 20 + (s / 30) * (W - 40);
const ticks = Array.from({ length: 7 }, (_, i) => i * 5);
---

<figure class="timeline">
	<svg viewBox={`0 0 ${W} 190`} role="img" aria-labelledby="tl-title tl-desc">
		<title id="tl-title">Music cue structure over 30 seconds</title>
		<desc id="tl-desc">
			A drone and pads from 0 to 5 seconds, an arpeggiated bass from 5, full drums from 11 to 24, then a drop to a single sub hit for the last seconds. Headlights switch on at 1.9 seconds.
		</desc>
		{
			sections.map((s, i) => (
				<g>
					<rect x={x(s.from) + 1} y={44 + (i % 2) * 0} width={x(s.to) - x(s.from) - 2} height="54" class={`band b${i}`} />
					<text x={x(s.from) + 10} y="66" class="band-label">
						{s.from}–{s.to} s
					</text>
					<foreignObject x={x(s.from) + 8} y="70" width={x(s.to) - x(s.from) - 14} height="28">
						<p class="band-text">{s.label}</p>
					</foreignObject>
				</g>
			))
		}
		<line x1={x(0)} x2={x(30)} y1="128" y2="128" class="axis" />
		{
			ticks.map((t) => (
				<g>
					<line x1={x(t)} x2={x(t)} y1="124" y2="134" class="axis" />
					<text x={x(t)} y="152" text-anchor="middle" class="tick">
						{t}s
					</text>
				</g>
			))
		}
		<line x1={x(1.9)} x2={x(1.9)} y1="24" y2="128" class="cue" />
		<text x={x(1.9) + 6} y="30" class="cue-label">Headlights on, 1.9 s</text>
		<text x={x(30)} y="180" text-anchor="end" class="tick">720 frames at 24 fps</text>
	</svg>
	<figcaption class="muted">Music structure of the cue. The rain bed runs under all of it, and engine, acceleration and pass-by effects sit on the shots they belong to.</figcaption>
</figure>

<style>
	.timeline {
		margin: 0;
		padding: var(--pad);
		border: 1px solid var(--rule);
		background: var(--ink-2);
		overflow-x: auto;
	}
	svg {
		min-width: 640px;
		width: 100%;
		height: auto;
	}
	.band {
		fill: var(--ink-3);
		stroke: var(--rule-hi);
	}
	.b2 {
		fill: rgba(240, 196, 58, 0.16);
		stroke: var(--tape);
	}
	.band-label {
		fill: var(--tape);
		font: 600 13px var(--f-body);
	}
	.band-text {
		margin: 0;
		font: 500 12px/1.3 var(--f-body);
		color: var(--bone);
	}
	.axis {
		stroke: var(--bone-3);
	}
	.tick {
		fill: var(--bone-2);
		font: 500 12px var(--f-body);
	}
	.cue {
		stroke: var(--tally);
		stroke-width: 1.5;
		stroke-dasharray: 3 3;
	}
	.cue-label {
		fill: var(--tally);
		font: 600 12px var(--f-body);
	}
	figcaption {
		margin-top: 12px;
		font-size: var(--t-sm);
		max-width: 70ch;
	}
</style>
