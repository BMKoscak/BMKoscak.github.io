---
import { Picture } from 'astro:assets';
import shot from '../../assets/photos/stadium-camera-hills.jpg';
const toggles = [
	{ id: 'thirds', label: 'Rule of thirds', on: true },
	{ id: 'safe', label: 'Safe areas', on: true },
	{ id: 'centre', label: 'Centre mark', on: false },
	{ id: 'zebra', label: 'Zebras', on: false },
];
---

<div class="vf rack" data-widget="viewfinder">
	<div class="cell vf-cell">
		<div class="frame" data-frame tabindex="0" role="button" aria-label="Viewfinder. Press Enter to take a shot.">
			<Picture
				src={shot}
				alt="A broadcast camera on a tripod looking over a green football pitch, with hills and houses behind the stadium."
				widths={[640, 1000, 1400]}
				sizes="(max-width: 860px) 100vw, 66vw"
				formats={['avif', 'webp']}
				quality={72}
				class="vf-img"
			/>
			<div class="zebra" aria-hidden="true"></div>
			<div class="thirds" aria-hidden="true"></div>
			<div class="safe action" aria-hidden="true"></div>
			<div class="safe title" aria-hidden="true"></div>
			<div class="centre" aria-hidden="true"></div>
			<div class="focus" data-focus aria-hidden="true"></div>
			<div class="hud top" aria-hidden="true"><span class="rec"><i></i>REC</span><span class="num" data-tc>00:00:00:00</span></div>
			<div class="hud bottom" aria-hidden="true"><span>f/4</span><span>1/50</span><span>0 dB</span><span>5600 K</span><span data-shots>0 shots</span></div>
		</div>
	</div>
	<div class="cell vf-panel">
		<p class="bus-name">Overlays</p>
		<div class="toggles">
			{toggles.map((t) => <button type="button" class="chip" data-toggle={t.id} aria-pressed={t.on ? 'true' : 'false'}>{t.label}</button>)}
		</div>
		<button type="button" class="btn btn-tape" data-shutter>Take the shot</button>
		<p class="note">Move over the frame to pull focus. Click it to shoot.</p>
	</div>
</div>

<style>
	.vf {
		grid-template-columns: 2fr 1fr;
	}
	.frame {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
		cursor: crosshair;
		user-select: none;
	}
	.frame :global(.vf-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.frame:global(.snap) :global(.vf-img) {
		animation: snap 0.3s ease-out;
	}
	@keyframes snap {
		from {
			filter: brightness(2.4) saturate(0);
		}
	}
	.thirds,
	.safe,
	.centre,
	.zebra {
		position: absolute;
		pointer-events: none;
		display: none;
	}
	.thirds {
		inset: 0;
		background:
			linear-gradient(to right, transparent calc(33.33% - 0.5px), rgba(255, 255, 255, 0.55) 0 calc(33.33% + 0.5px), transparent 0 calc(66.66% - 0.5px), rgba(255, 255, 255, 0.55) 0 calc(66.66% + 0.5px), transparent 0),
			linear-gradient(to bottom, transparent calc(33.33% - 0.5px), rgba(255, 255, 255, 0.55) 0 calc(33.33% + 0.5px), transparent 0 calc(66.66% - 0.5px), rgba(255, 255, 255, 0.55) 0 calc(66.66% + 0.5px), transparent 0);
	}
	.safe.action {
		inset: 3.5%;
		border: 1px solid rgba(255, 255, 255, 0.8);
	}
	.safe.title {
		inset: 5%;
		border: 1px dashed var(--tape);
	}
	.centre {
		left: 50%;
		top: 50%;
		width: 26px;
		height: 26px;
		margin: -13px 0 0 -13px;
		background:
			linear-gradient(#fff, #fff) center / 100% 1px no-repeat,
			linear-gradient(#fff, #fff) center / 1px 100% no-repeat;
	}
	.zebra {
		inset: 0;
		background: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.9) 0 3px, transparent 3px 8px);
		mask: linear-gradient(to bottom, #000 0 22%, transparent 34%);
		-webkit-mask: linear-gradient(to bottom, #000 0 22%, transparent 34%);
		mix-blend-mode: difference;
	}
	.frame:global(.show-thirds) .thirds,
	.frame:global(.show-safe) .safe,
	.frame:global(.show-centre) .centre,
	.frame:global(.show-zebra) .zebra {
		display: block;
	}
	.focus {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 72px;
		height: 50px;
		margin: -25px 0 0 -36px;
		border: 1.5px solid #fff;
		transition: transform 0.18s var(--ease), border-color 0.2s;
	}
	.focus:global(.locked) {
		border-color: #7dff9a;
	}
	.hud {
		position: absolute;
		left: 4%;
		right: 4%;
		display: flex;
		justify-content: space-between;
		gap: 10px;
		font-family: var(--f-display);
		font-weight: 650;
		font-size: var(--t-sm);
		color: #fff;
		text-shadow: 0 1px 3px #000;
	}
	.hud.top {
		top: 4%;
	}
	.hud.bottom {
		bottom: 4%;
	}
	.rec {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.rec i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--tally);
	}
	.vf-panel {
		display: grid;
		gap: 16px;
		align-content: start;
	}
	.toggles {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	@media (max-width: 860px) {
		.vf {
			grid-template-columns: 1fr;
		}
		.hud.bottom span:nth-child(3),
		.hud.bottom span:nth-child(4) {
			display: none;
		}
	}
</style>
