---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
	src: ImageMetadata;
	alt: string;
	widths?: number[];
	sizes?: string;
	ratio?: string;
	eager?: boolean;
	develop?: boolean;
	class?: string;
	position?: string;
}
const {
	src,
	alt,
	widths = [480, 800, 1200, 1600],
	sizes = '(max-width: 760px) 100vw, 50vw',
	ratio,
	eager = false,
	develop = true,
	class: cls = '',
	position = 'center',
} = Astro.props;
---

<figure class:list={['photo', cls]} data-develop={develop ? '' : undefined} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
	<Picture
		src={src}
		alt={alt}
		widths={widths.filter((w) => w <= src.width)}
		sizes={sizes}
		formats={['avif', 'webp']}
		fallbackFormat="jpg"
		quality={72}
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : 'auto'}
		decoding="async"
		style={`object-position:${position}`}
	/>
	<slot />
</figure>
