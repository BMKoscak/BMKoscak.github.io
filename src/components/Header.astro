---
import { NAV } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href="/" aria-label="The Benn, home">The Benn</a>
		<nav class="nav" id="site-nav" aria-label="Main">
			{
				NAV.map((n) => (
					<a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
						{n.label}
					</a>
				))
			}
		</nav>
		<div class="bar-right">
			<span class="status"><i aria-hidden="true"></i>Taking new projects</span>
			<span class="clock" title="Local time in Ljubljana">Ljubljana <b data-clock>--:--</b></span>
			<button class="icon-btn palette-btn" type="button" data-palette-open aria-haspopup="dialog">
				Jump to <kbd>/</kbd>
			</button>
			<button class="icon-btn" type="button" data-sound-toggle aria-pressed="false" title="Interface sound">
				<span class="meter" aria-hidden="true"><i></i><i></i><i></i></span>
				<span data-sound-label>Sound off</span>
			</button>
			<button class="icon-btn menu-btn" type="button" data-menu aria-expanded="false" aria-controls="site-nav">
				Menu
			</button>
		</div>
	</div>
</header>
