---
import Base from '../layouts/Base.astro';
import ScopeBox from '../components/ScopeBox.astro';
---

<Base title="Page not found | The Benn" description="This page does not exist. Go back to the home page or jump to the work and lab." noindex>
	<section class="wrap lost">
		<div class="rack grid">
			<div class="cell">
				<p class="mini-label">Error 404</p>
				<h1 class="h-section">No signal on this channel.</h1>
				<p class="lede">The page you asked for does not exist or has moved.</p>
				<div class="links">
					<a class="btn btn-tape" href="/">Go to the home page</a>
					<a class="btn" href="/work/">See the work</a>
				</div>
				<p class="muted">Or press <kbd>/</kbd> to jump to any page.</p>
			</div>
			<ScopeBox ratio="7:5:0.1" label="Searching" class="lost-scope" drift={0.4} speed={0.6} />
		</div>
	</section>
</Base>

<style>
	.lost {
		padding-top: clamp(24px, 4vw, 48px);
	}
	.grid {
		grid-template-columns: 1.3fr 1fr;
	}
	.grid .cell {
		display: grid;
		gap: 20px;
		align-content: center;
		padding-block: clamp(48px, 8vw, 120px);
	}
	.grid p {
		margin: 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	:global(.lost-scope) {
		min-height: 300px;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
